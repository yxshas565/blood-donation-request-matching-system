import 'dotenv/config';
import test,{before,after} from 'node:test';
import assert from 'node:assert/strict';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import app from '../src/app.js';
import {testMySQL,mysqlPool} from '../src/config/mysql.js';
import {connectMongoDB,closeMongoDB,getMongoDB} from '../src/config/mongodb.js';
import {COMPAT} from '../src/services/domain.js';

let server,base,stamp,donorToken,hospitalToken,orgToken,adminToken;
const fixture={userIds:[],donorIds:[],hospitalIds:[],organizationIds:[],requestIds:[],donationIds:[],emails:[]};
const headers=token=>({authorization:`Bearer ${token}`,'content-type':'application/json'});
async function call(path,{method='GET',token,body}={}){const urlPath=path.startsWith('/api/')?path:`/api${path}`;const res=await fetch(base+urlPath,{method,headers:token?headers(token):{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});let data={};try{data=await res.json();}catch{}return {status:res.status,data};}
async function register(role,extra={}){const email=`audit-${role.toLowerCase()}-${stamp}-${fixture.emails.length}@example.invalid`;fixture.emails.push(email);const out=await call('/api/auth/register',{method:'POST',body:{name:`Audit ${role}`,email,password:'Audit-Only-Password-93',role,...extra}});assert.equal(out.status,201,JSON.stringify(out.data));fixture.userIds.push(out.data.user.User_ID);return out.data;}
before(async()=>{assert.equal(process.env.MYSQL_DATABASE,'BloodDonationDB_Test','DB tests require MYSQL_DATABASE=BloodDonationDB_Test');assert.equal(process.env.MONGODB_DATABASE,'BloodDonationDB_Test','DB tests require MONGODB_DATABASE=BloodDonationDB_Test');assert.equal(process.env.ALLOW_DB_FIXTURE_MUTATIONS,'1','DB tests require explicit ALLOW_DB_FIXTURE_MUTATIONS=1');assert.ok(process.env.JWT_SECRET,'JWT_SECRET is required for integration tests');await testMySQL();await connectMongoDB();server=app.listen(0,'127.0.0.1');await new Promise(resolve=>server.once('listening',resolve));base=`http://127.0.0.1:${server.address().port}`;stamp=Date.now();});
after(async()=>{try{if(fixture.donorIds.length){await getMongoDB().collection('DonorLocation').deleteMany({donor_id:{$in:fixture.donorIds}});await getMongoDB().collection('DonationHistory').deleteMany({donor_id:{$in:fixture.donorIds}});}if(fixture.userIds.length)await getMongoDB().collection('Notifications').deleteMany({recipient_user_id:{$in:fixture.userIds}});if(fixture.requestIds.length)await getMongoDB().collection('Notifications').deleteMany({related_request_id:{$in:fixture.requestIds}});if(fixture.donationIds.length)await getMongoDB().collection('DonationHistory').deleteMany({mysql_donation_id:{$in:fixture.donationIds}});for(const id of fixture.requestIds)await mysqlPool.execute('DELETE FROM BloodRequest WHERE Request_ID=?',[id]);for(const id of fixture.donationIds)await mysqlPool.execute('DELETE FROM Donation WHERE Donation_ID=?',[id]);for(const id of fixture.hospitalIds){await mysqlPool.execute('DELETE FROM BloodInventory WHERE Hospital_ID=?',[id]);await mysqlPool.execute('DELETE FROM Hospital WHERE Hospital_ID=?',[id]);}for(const id of fixture.organizationIds)await mysqlPool.execute('DELETE FROM Organization WHERE Organization_ID=?',[id]);for(const id of fixture.donorIds)await mysqlPool.execute('DELETE FROM Donor WHERE Donor_ID=?',[id]);for(const id of fixture.userIds)await mysqlPool.execute('DELETE FROM `User` WHERE User_ID=?',[id]);}catch(e){console.error('Isolated fixture cleanup failed:',e.message);}if(server)await new Promise(resolve=>server.close(resolve));await Promise.allSettled([mysqlPool.end(),closeMongoDB()]);});

test('live MySQL/MongoDB connections, health, anonymous authorization and schema',async()=>{const h=await call('/api/health');assert.equal(h.status,200);assert.deepEqual(h.data.databases,{mysql:'connected',mongodb:'connected'});assert.equal((await call('/api/donors/me')).status,401);const [tables]=await mysqlPool.query("SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME IN ('User','BloodGroup','Donor','Donation','Hospital','Organization','BloodRequest','BloodInventory')");assert.equal(tables.length,8);for(const name of ['DonorLocation','DonationHistory','Notifications'])assert.ok(await getMongoDB().listCollections({name}).hasNext());});

test('registration, login, profile, donor availability and location; hospital and organization ownership',async()=>{const [[bg]]=await mysqlPool.query("SELECT BloodGroup_ID FROM BloodGroup WHERE Blood_Type='O' AND Rh_Factor='-' LIMIT 1");const badEmail=`audit-invalid-${stamp}@example.invalid`;const bad=await call('/api/auth/register',{method:'POST',body:{name:'Bad Group',email:badEmail,password:'Audit-Only-Password-93',role:'Donor',bloodGroupId:999999,dateOfBirth:'1990-01-01',gender:'Other'}});assert.equal(bad.status,400);const donor=await register('Donor',{bloodGroupId:bg.BloodGroup_ID,dateOfBirth:'1990-01-01',gender:'Other'});donorToken=donor.token;const [[d]]=await mysqlPool.execute('SELECT Donor_ID FROM Donor WHERE User_ID=?',[donor.user.User_ID]);fixture.donorIds.push(d.Donor_ID);let out=await call('/api/auth/login',{method:'POST',body:{email:fixture.emails[0],password:'Audit-Only-Password-93'}});assert.equal(out.status,200);assert.equal((await call('/api/auth/login',{method:'POST',body:{email:fixture.emails[0],password:'wrong-password'}})).status,401);assert.equal((await call('/api/auth/register',{method:'POST',body:{name:'bad',email:'bad',password:'x',role:'Admin'}})).status,400);assert.equal((await call('/api/auth/register',{method:'POST',body:{name:'dup',email:fixture.emails[0],password:'Audit-Only-Password-93',role:'Donor',bloodGroupId:bg.BloodGroup_ID,dateOfBirth:'1990-01-01',gender:'Other'}})).status,409);assert.equal((await call('/api/auth/me',{token:donorToken})).status,200);assert.equal((await call('/api/users/me',{token:donorToken})).status,200);assert.equal((await call('/api/admin/summary',{token:donorToken})).status,403);assert.equal((await call('/api/donors/me',{token:donorToken})).status,200);out=await call('/api/donors/me/availability',{method:'PATCH',token:donorToken,body:{available:true}});assert.equal(out.status,200);assert.equal((await call('/api/donors/me/location',{method:'PUT',token:donorToken,body:{longitude:77,latitude:12,city:'Audit City',area:'Audit Area'}})).status,200);assert.deepEqual((await getMongoDB().collection('DonorLocation').findOne({donor_id:d.Donor_ID})).location.coordinates,[77,12]);assert.equal((await call(`/api/donors/${d.Donor_ID}`,{token:donorToken})).status,200);
 const h=await register('Hospital',{hospitalName:`Audit Hospital ${stamp}`});hospitalToken=h.token;const [[hospital]]=await mysqlPool.execute('SELECT Hospital_ID FROM Hospital WHERE Email=?',[h.user.Email]);fixture.hospitalIds.push(hospital.Hospital_ID);assert.equal((await call('/api/hospitals/me',{token:hospitalToken})).status,200);assert.equal((await call('/api/hospitals/me',{token:donorToken})).status,403);assert.equal((await call('/api/hospitals/me',{method:'PATCH',token:hospitalToken,body:{address:'Audit Address'}})).status,200);assert.equal((await call('/api/hospitals/me/matching/O-?longitude=77&latitude=12',{token:hospitalToken})).status,200);
 const o=await register('Organization',{organizationName:`Audit Organization ${stamp}`,organizationType:'Test'});orgToken=o.token;const [[org]]=await mysqlPool.execute('SELECT Organization_ID FROM Organization WHERE Email=?',[o.user.Email]);fixture.organizationIds.push(org.Organization_ID);assert.equal((await call('/api/organizations/me',{token:orgToken})).status,200);assert.equal((await call('/api/organizations/me',{method:'PATCH',token:orgToken,body:{address:'Audit Address'}})).status,200);assert.equal((await call('/api/organizations/me/matching/O-',{token:orgToken})).status,200);assert.equal((await call('/api/donors/me',{token:hospitalToken})).status,403);
});

test('every ABO/Rh compatibility rule and Mongo geospatial ranking/fallback',async()=>{const expected={'O-':['O-'],'O+':['O-','O+'],'A-':['O-','A-'],'A+':['O-','O+','A-','A+'],'B-':['O-','B-'],'B+':['O-','O+','B-','B+'],'AB-':['O-','A-','B-','AB-'],'AB+':['O-','O+','A-','A+','B-','B+','AB-','AB+']};assert.deepEqual(COMPAT,expected);for(const group of Object.keys(expected)){const out=await call(`/api/matching/${encodeURIComponent(group)}`,{token:donorToken});assert.equal(out.status,200);assert.equal(out.data.recipientBloodGroup,group);for(const match of out.data.matches)assert.ok(expected[group].includes(match.bloodGroup));assert.ok(out.data.clinicalDisclaimer.includes('clinical screening'));}const geo=await call('/api/matching/O-?longitude=77&latitude=12',{token:donorToken});assert.equal(geo.status,200);assert.equal(geo.data.geographicRanking,true);assert.equal(geo.data.matches[0].donorId,fixture.donorIds[0]);assert.ok(geo.data.matches[0].distanceRank);const fallback=await call('/api/matching/O-',{token:donorToken});assert.equal(fallback.status,200);assert.equal(fallback.data.geographicRanking,false);assert.ok(fallback.data.matches.every(m=>m.distanceRank===null));assert.equal((await call('/api/matching/O-?longitude=300&latitude=12',{token:donorToken})).status,400);assert.equal((await call('/api/matching/O-?longitude=77',{token:donorToken})).status,400);await call('/api/donors/me/availability',{method:'PATCH',token:donorToken,body:{available:false}});const unavailable=await call('/api/matching/O-',{token:donorToken});assert.ok(unavailable.data.matches.every(m=>m.donorId!==fixture.donorIds[0]));await call('/api/donors/me/availability',{method:'PATCH',token:donorToken,body:{available:true}});});

test('donation create, approve, reject, MySQL/Mongo sync, last donation date and inventory credit',async()=>{const [[bg]]=await mysqlPool.query("SELECT BloodGroup_ID FROM BloodGroup WHERE Blood_Type='O' AND Rh_Factor='-' LIMIT 1");const hospitalId=fixture.hospitalIds[0];let x=await call('/donations',{method:'POST',token:donorToken,body:{quantity:2,donationDate:'2026-10-30',hospitalId}});assert.equal(x.status,201);const approvedId=x.data.donationId;fixture.donationIds.push(approvedId);assert.ok((await call('/donors/me/donations',{token:donorToken})).data.donations.some(z=>z.Donation_ID===approvedId));x=await call(`/donations/${approvedId}/status`,{method:'PATCH',token:hospitalToken,body:{status:'Approved'}});assert.equal(x.status,200,JSON.stringify(x.data));let [[sql]]=await mysqlPool.execute('SELECT Donation_Status,Donation_Date FROM Donation WHERE Donation_ID=?',[approvedId]);assert.equal(sql.Donation_Status,'Approved');const hist=await getMongoDB().collection('DonationHistory').findOne({mysql_donation_id:approvedId});assert.equal(hist.donation_status,'Approved');assert.equal(hist.receiving_hospital_id,hospitalId);const [[donor]]=await mysqlPool.execute('SELECT Last_Donation_Date FROM Donor WHERE Donor_ID=?',[fixture.donorIds[0]]);assert.equal(String(donor.Last_Donation_Date).slice(0,10),'2026-10-30');const [[stock]]=await mysqlPool.execute('SELECT Quantity_Available FROM BloodInventory WHERE Hospital_ID=? AND BloodGroup_ID=?',[hospitalId,bg.BloodGroup_ID]);assert.equal(Number(stock.Quantity_Available),2);assert.equal((await call(`/donations/${approvedId}/status`,{method:'PATCH',token:hospitalToken,body:{status:'Rejected'}})).status,409);assert.equal((await call('/donations',{token:donorToken})).data.donations.some(z=>z.Donation_ID===approvedId),true);let y=await call('/donations',{method:'POST',token:donorToken,body:{quantity:1,hospitalId}});assert.equal(y.status,201);fixture.donationIds.push(y.data.donationId);assert.equal((await call(`/donations/${y.data.donationId}/status`,{method:'PATCH',token:hospitalToken,body:{status:'Rejected'}})).status,200);assert.equal((await getMongoDB().collection('DonationHistory').findOne({mysql_donation_id:y.data.donationId})).donation_status,'Rejected');const [otherHospitals]=await mysqlPool.execute('SELECT Hospital_ID FROM Hospital WHERE Hospital_ID<>? LIMIT 1',[hospitalId]);if(otherHospitals.length){const cross=await call('/donations',{method:'POST',token:donorToken,body:{quantity:0.5,hospitalId:otherHospitals[0].Hospital_ID}});assert.equal(cross.status,201);fixture.donationIds.push(cross.data.donationId);assert.equal((await call(`/donations/${cross.data.donationId}/status`,{method:'PATCH',token:hospitalToken,body:{status:'Approved'}})).status,403);const [[stillPending]]=await mysqlPool.execute('SELECT Donation_Status FROM Donation WHERE Donation_ID=?',[cross.data.donationId]);assert.equal(stillPending.Donation_Status,'Pending');}const [[after]]=await mysqlPool.execute('SELECT Quantity_Available FROM BloodInventory WHERE Hospital_ID=? AND BloodGroup_ID=?',[hospitalId,bg.BloodGroup_ID]);assert.equal(Number(after.Quantity_Available),2);assert.equal((await call('/donations',{token:hospitalToken})).status,200);});

test('hospital and organization request ownership, retrieval, cancellation, fulfillment and insufficient-stock rollback',async()=>{const [[bg]]=await mysqlPool.query("SELECT BloodGroup_ID FROM BloodGroup WHERE Blood_Type='O' AND Rh_Factor='-' LIMIT 1");let x=await call('/requests',{method:'POST',token:hospitalToken,body:{bloodGroupId:bg.BloodGroup_ID,quantity:1,urgency:'High'}});assert.equal(x.status,201,JSON.stringify(x.data));const hid=x.data.requestId;fixture.requestIds.push(hid);assert.equal((await call(`/requests/${hid}`,{token:hospitalToken})).status,200);assert.equal((await call(`/requests/${hid}`,{token:orgToken})).status,403);assert.equal((await call('/requests?status=Pending&urgency=High',{token:hospitalToken})).status,200);assert.equal((await call('/requests',{method:'POST',token:hospitalToken,body:{bloodGroupId:999999,quantity:1}})).status,400);assert.equal((await call(`/requests/${hid}/status`,{method:'PATCH',token:hospitalToken,body:{status:'Fulfilled'}})).status,400);x=await call(`/requests/${hid}/fulfil`,{method:'POST',token:hospitalToken});assert.equal(x.status,200,JSON.stringify(x.data));const [[stockAfter]]=await mysqlPool.execute('SELECT Quantity_Available FROM BloodInventory WHERE Hospital_ID=? AND BloodGroup_ID=?',[fixture.hospitalIds[0],bg.BloodGroup_ID]);assert.equal(Number(stockAfter.Quantity_Available),1);let low=await call('/requests',{method:'POST',token:hospitalToken,body:{bloodGroupId:bg.BloodGroup_ID,quantity:2,urgency:'Critical'}});assert.equal(low.status,201);fixture.requestIds.push(low.data.requestId);assert.equal((await call(`/requests/${low.data.requestId}/fulfil`,{method:'POST',token:hospitalToken})).status,409);const [[pending]]=await mysqlPool.execute('SELECT Request_Status FROM BloodRequest WHERE Request_ID=?',[low.data.requestId]);assert.equal(pending.Request_Status,'Pending');const [[stockStill]]=await mysqlPool.execute('SELECT Quantity_Available FROM BloodInventory WHERE Hospital_ID=? AND BloodGroup_ID=?',[fixture.hospitalIds[0],bg.BloodGroup_ID]);assert.equal(Number(stockStill.Quantity_Available),1);let orgReq=await call('/requests',{method:'POST',token:orgToken,body:{bloodGroupId:bg.BloodGroup_ID,quantity:1}});assert.equal(orgReq.status,201);fixture.requestIds.push(orgReq.data.requestId);assert.equal((await call(`/requests/${orgReq.data.requestId}/status`,{method:'PATCH',token:orgToken,body:{status:'Cancelled'}})).status,200);assert.equal((await call(`/requests/${orgReq.data.requestId}`,{token:hospitalToken})).status,403);assert.equal((await call(`/requests/${hid}/status`,{method:'PATCH',token:orgToken,body:{status:'Cancelled'}})).status,403);assert.equal((await call('/hospitals/me/inventory',{token:hospitalToken})).status,200);assert.equal((await call('/inventory',{token:donorToken})).status,200);});

test('notifications are generated, retrievable, markable and isolated; all admin APIs protected and operational',async()=>{const own=await call('/notifications?unread=true',{token:donorToken});assert.equal(own.status,200);const n=own.data.notifications.find(z=>fixture.requestIds.includes(Number(z.related_request_id)));assert.ok(n,`expected donor notification; unread count=${own.data.notifications.length}; fixture requests=${fixture.requestIds.join(',')}`);const foreign=await call('/notifications',{token:orgToken});assert.equal(foreign.status,200);assert.ok(!foreign.data.notifications.some(z=>String(z._id)===String(n._id)));assert.equal((await call(`/notifications/${n._id}/read`,{method:'PATCH',token:orgToken})).data.updated,false);assert.equal((await call(`/notifications/${n._id}/read`,{method:'PATCH',token:donorToken})).data.updated,true);const adminEmail=`audit-admin-${stamp}@example.invalid`;fixture.emails.push(adminEmail);const hash=await bcrypt.hash('Audit-Only-Admin-Password-93',10);const [insert]=await mysqlPool.execute('INSERT INTO `User` (Name,Email,Password,Role) VALUES (?,?,?,\'Admin\')',['Audit Admin',adminEmail,hash]);fixture.userIds.push(insert.insertId);adminToken=jwt.sign({userId:insert.insertId,role:'Admin'},process.env.JWT_SECRET,{expiresIn:'5m'});for(const path of ['/admin/summary','/admin/users','/admin/donors','/admin/requests','/admin/donations','/admin/inventory','/admin/organizations']){const result=await call(path,{token:adminToken});assert.equal(result.status,200,`${path}: ${JSON.stringify(result.data)}`);}const [[bg]]=await mysqlPool.query("SELECT BloodGroup_ID FROM BloodGroup WHERE Blood_Type='O' AND Rh_Factor='-' LIMIT 1");assert.equal((await call(`/admin/inventory/${fixture.hospitalIds[0]}/${bg.BloodGroup_ID}`,{method:'PUT',token:adminToken,body:{quantity:0}})).status,200);assert.equal((await call(`/admin/inventory/${fixture.hospitalIds[0]}/${bg.BloodGroup_ID}`,{method:'PUT',token:adminToken,body:{quantity:-1}})).status,400);assert.equal((await call(`/admin/inventory/${fixture.hospitalIds[0]}/${bg.BloodGroup_ID}`,{method:'PUT',token:donorToken,body:{quantity:10}})).status,403);for(const path of ['/admin/summary','/admin/users','/admin/donors','/admin/requests','/admin/donations','/admin/inventory','/admin/organizations'])assert.equal((await call(path,{token:donorToken})).status,403);});

